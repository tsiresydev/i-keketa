# Configuration locale du frontend (ne pas commiter)
# Copier ce fichier vers .env : cp .env.example .env

# URL de l'API utilisée par le navigateur (vide = même origine / proxy de développement)
VITE_API_URL=

# Cible du proxy de développement Vite (API REST + WebSocket)
VITE_API_PROXY_TARGET=http://localhost:3000
