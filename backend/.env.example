# Configuration locale du backend (ne pas commiter)
# Copier ce fichier vers .env : cp .env.example .env

NODE_ENV=development
PORT=3000

# Connexion MongoDB
MONGODB_URI=mongodb://localhost:27017/chatdb

# Démarre un MongoDB en mémoire lorsque MONGODB_URI est vide (développement uniquement)
USE_IN_MEMORY_DB=false

# Secret de signature des jetons JWT (minimum 16 caractères) — OBLIGATOIRE
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Nombre de tours de salage bcrypt
BCRYPT_SALT_ROUNDS=10

# Origines autorisées (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173

# Limitation de débit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Limitation de débit des messages temps réel
WS_MESSAGE_RATE_MAX=20
WS_MESSAGE_RATE_WINDOW_MS=10000

# Longueur maximale d'un message
MESSAGE_MAX_LENGTH=2000

# Photo de profil (stockage local, dossier relatif au process)
PHOTO_MAX_SIZE_BYTES=2097152
PHOTO_STORAGE_DIR=uploads/photos

# Signalement d'abus (longueur du descriptif, limitation de débit dédiée)
REPORT_DETAILS_MAX_LENGTH=1000
REPORT_RATE_LIMIT_MAX=5
REPORT_RATE_LIMIT_WINDOW_MS=3600000

# Version du binaire MongoDB en mémoire (mongodb-memory-server)
MONGOMS_VERSION=7.0.24
