# Configuration locale (ne pas committer)
PORT=3000
MONGODB_URI=mongodb://localhost:27017/chatdb
JWT_SECRET=change-me
NODE_ENV=development

# --- Variables ajoutées par le Sprint 1 -------------------------------
# Durée de vie du jeton JWT
JWT_EXPIRES_IN=7d

# Nombre de tours de salage bcrypt
BCRYPT_SALT_ROUNDS=10

# Origines autorisées (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173

# Limitation de débit (fenêtre et maximum de requêtes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Limitation de débit des messages temps réel
WS_MESSAGE_RATE_MAX=20
WS_MESSAGE_RATE_WINDOW_MS=10000

# Longueur maximale d'un message
MESSAGE_MAX_LENGTH=2000

# Photo de profil (taille maximale en octets, dossier de stockage relatif au process)
PHOTO_MAX_SIZE_BYTES=2097152
PHOTO_STORAGE_DIR=uploads/photos

# Démarre un MongoDB en mémoire si MONGODB_URI est vide (développement uniquement)
USE_IN_MEMORY_DB=false

# Version du binaire MongoDB en mémoire (mongodb-memory-server)
MONGOMS_VERSION=7.0.24

# --- Variables frontend (frontend/.env) -------------------------------
# URL de l'API en production (vide = même origine)
VITE_API_URL=
# Cible du proxy de développement (Vite -> backend)
VITE_API_PROXY_TARGET=http://localhost:3000
